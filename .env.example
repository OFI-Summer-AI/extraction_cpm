# ============================================================
# Symbio API
# ============================================================
SYMBIO_BASE_URL=https://your-instance.symbioweb.com
SYMBIO_STORAGE_COLLECTION=your_collection
SYMBIO_TENANT=your_tenant
SYMBIO_AUTH_TOKEN=your_symbio_auth_token_here

# ============================================================
# Celonis (PyCelonis)
# ============================================================
CELONIS_TEAM_URL=https://your-team.eu-1.celonis.cloud/
CELONIS_API_TOKEN=your_celonis_api_token_here
CELONIS_DATA_POOL_ID=your_data_pool_id_here

# ============================================================
# AWS S3 (Backup de procesos)
# ============================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=eu-west-1
AWS_S3_BUCKET=your_s3_bucket_name_here
